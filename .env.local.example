# ─────────────────────────────────────────────────────────────────────────────
# .env.local.example
#
# Copy this file to .env.local and fill in real values before running locally.
# NEVER commit .env.local — it is listed in .gitignore.
# This example file is safe to commit; it contains no real secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ---------------------------------------------------------------------------
# App — Public variables (exposed to the browser via Next.js NEXT_PUBLIC_ prefix)
# ---------------------------------------------------------------------------

# Base URL of the application (used for canonical links, OG tags, etc.)
# Example: http://localhost:3000  or  https://tic-tac-toe.example.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: analytics / telemetry write key (set to empty string to disable)
# Example: NEXT_PUBLIC_ANALYTICS_KEY=your-write-key-here
NEXT_PUBLIC_ANALYTICS_KEY=

# ---------------------------------------------------------------------------
# Server-side only variables (NOT prefixed with NEXT_PUBLIC_)
# These are never sent to the browser.
# ---------------------------------------------------------------------------

# Optional: API secret key for any future server-side integrations
# Example: API_SECRET_KEY=supersecretvalue
API_SECRET_KEY=

# Node environment — typically set by the runtime; override here only if needed
# Values: development | test | production
# NODE_ENV=development
